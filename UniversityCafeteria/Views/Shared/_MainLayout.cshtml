
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - University Cafeteria</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <nav class="navbar navbar-expand navbar-dark bg-primary">
        <div class="container">

            <a class="navbar-brand"
               asp-controller="Supply"
               asp-action="Index">
                University Cafeteria
            </a>

           
            <div class="navbar-nav">

                <a class="nav-link"
                   asp-controller="Supply"
                   asp-action="Index">Home</a>

                <a class="nav-link"
                   asp-controller="Supply"
                   asp-action="Products">Products</a>

                <a class="nav-link"
                   asp-controller="Supply"
                   asp-action="Suppliers">Suppliers</a>

                <a class="nav-link"
                   asp-controller="Supply"
                   asp-action="CreateRequest">Create Request</a>

                <a class="nav-link"
                   asp-controller="Supply"
                   asp-action="About">About</a>

            </div>


        </div>
    </nav>

    <main class="container mt-4">
        @RenderBody()
    </main>

    <footer class="bg-light text-center p-3 mt-5">
        <p>© 2026 University Cafeteria</p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
