@{
    ViewData["Title"] = "Create Supply Request";
}

<h2>Create Supply Request</h2>

<form asp-controller="SupplyRequest"
      asp-action="AddItem"
      method="post">

    <label>Product Name</label>
    <input type="text" name="ProductName"
           class="form-control" required />

    <label>Category</label>
    <input type="text" name="Category"
           class="form-control" />

    <label>Quantity</label>
    <input type="number" name="Quantity"
           class="form-control" min="1" required />

    <label>Unit Price</label>
    <input type="number" name="UnitPrice"
           class="form-control" min="0.01"
           step="0.01" required />

    <label>Priority</label>
    <select name="Priority" class="form-select">
        <option value="Normal">Normal</option>
        <option value="Urgent">Urgent</option>
        <option value="Emergency">Emergency</option>
    </select>

    <button type="submit" class="btn btn-primary mt-3">
        Add Item
    </button>

</form>
@if (ViewBag.Message != null)
{
    <p class="mt-3">@ViewBag.Message</p>
}

<h3>Added Products</h3>

@if (ViewBag.Products != null && ViewBag.Products.Count > 0)
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Product Name</th>
                <th>Category</th>
                <th>Quantity</th>
                <th>Unit Price</th>
                <th>Priority</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in ViewBag.Products)
            {
                <tr>
                    <td>@item.ProductName</td>
                    <td>@item.Category</td>
                    <td>@item.Quantity</td>
                    <td>@item.UnitPrice</td>
                    <td>@item.Priority</td>
                </tr>
            }
        </tbody>
    </table>
}
