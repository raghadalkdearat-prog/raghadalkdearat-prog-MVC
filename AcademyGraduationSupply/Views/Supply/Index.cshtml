@{
    Layout = "~/Views/Shared/_SupplyLayout.cshtml";
}


@if (TempData["Message"] != null)
{
    <div class="alert alert-danger">
        @TempData["Message"]
    </div>
}

<h1>Offer Menue</h1>
@foreach (var offer in ViewBag.Offers)
{
    

    <div>
        <h3>@offer.OfferName</h3>

        <p>Category: @offer.Category</p>

        <p>Supplier: @offer.SupplierName</p>

        <p>Quantity: @offer.Quantity</p>

        <p>Unit Price: @offer.UnitPrice JD</p>

        <hr />
    </div>


    <form method="post" action=@Url.Action("SelectOffer","Supply")>
        <input type="hidden" name="Id" value="@offer.Id" />
        <button type="submit">select offer</button>
    </form>


   
}
<a href="@Url.Action("Review", "Supply")">
    Review Selected Offers
</a>