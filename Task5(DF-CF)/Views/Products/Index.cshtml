@{
}
@model List<Task5_DF_CF_.Models.Product>

<h2>Products</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Price</th>
            <th>Quantity</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.ProductId</td>
                <td>@product.ProductName</td>
                <td>@product.ProductPrice</td>
                <td>@product.Quantity</td>
            </tr>
        }
    </tbody>
</table>
<hr />


